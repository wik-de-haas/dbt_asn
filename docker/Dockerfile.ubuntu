FROM ubuntu:22.04

# Simulate WSL-like environment
ENV DEBIAN_FRONTEND=noninteractive \
    WSL_DISTRO_NAME=Ubuntu-22.04 \
    PATH="/root/.cargo/bin:$PATH"

# Install dependencies, create user, install uv, and setup permissions in single layer
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl \
    git \
    build-essential \
    sudo \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y \
    python3.12 \
    python3.12-venv \
    python3.12-dev \
    && ln -sf /usr/bin/python3.12 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -s /bin/bash testuser \
    && usermod -aG sudo testuser \
    && echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && ln -s /root/.cargo/bin/uv /usr/local/bin/uv

# Create entrypoint and copy project files
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chown=testuser:testuser . /home/testuser/dbt
RUN chmod +x /usr/local/bin/entrypoint.sh \
    && find /home/testuser/dbt -path "*/deployment/local_setup/setup.sh" -exec chmod +x {} +

USER testuser
WORKDIR /home/testuser/dbt

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]
